<% provide(:title,'User Information')%>
<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<div class="user-info-container">
<p> <strong>PK:</strong> <%= @user.id%></p>
<p> <strong>Name:</strong> <%= @user.name%></p>
<p> <strong>Email:</strong> <%= @user.email%></p>
<p> <strong>Phone:</strong> <%= @user.phone%></p>
<p> <strong>Created:</strong> <%= @user.created_at%></p>
<p> <strong>Updated:</strong> <%= @user.updated_at%></p>
<p> <strong>Password:</strong> ********</p>
</div>

<div>
    <table class=mytable>
        <thead>
            <tr>
                <th>PK</th>
                <th>Title</th>
                <th>Topic</th>
                <th>Create_AT</th>
                <th>UPDATED_AT</th>
                <th>DELETE</th>
            </tr>
        </thead>
        <tbody>
            <% if @posts.present? %>
                <% @posts.each do |post| %>
                <tr>
                    <td><%= post.id %></td>
                    <td><%= post.titles %></td>
                    <td><%= post.topics %></td>
                    <td><%= post.created_at %></td>
                    <td><%= post.updated_at %></td>
                    <td><%= button_to 'Delete', post_path(post.id), method: :delete%></td>
                </tr>
            <% end %>
            <% else %>
                <tr>
                    <td colspan="3">No posts available</td>
                </tr>
            <% end %>
        </tbody>
        <tfoot>
            <tr> <td colspan="4">End of Posts List</td> </tr>
        </tfoot>
    </table>
</div>
