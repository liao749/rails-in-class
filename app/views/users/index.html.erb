<%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
<table  class="mytable">
  <thead>
    <tr>
      <th>PK</th>
      <th>Name</th>
      <th>Email</th>
      <th>Phone</th>
      <th>Show</th>
      <th>Edit</th>
      <th>Delete</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.name%></td>
        <td><%= user.email%></td>
        <td><%= user.phone%></td>
        <td> <%= link_to 'Show', show_user_path(user.id)%> </td>
        <td> <%= link_to 'Edit', edit_user_path(user.id)%> </td>
        <td><%= button_to "Delete", user_path(user.id), method: :delete %> </td>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4">End of User List</td>
      </tr>
    </tfoot>
  </table>
